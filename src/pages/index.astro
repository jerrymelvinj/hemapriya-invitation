---
// src/pages/index.astro
// ZERO-JAVASCRIPT ASTRO ARCHITECTURE
// Visual Hierarchy & Design System mapped 1:1 from "Venkat.jpg"
// Content: D. Maneshkumar & Visutha (alias) R. Hemapriya Wedding

const couple = {
  initials: "M & H",
  groom: {
    name: "D. MANESHKUMAR",
    education: "BCA, MBA, M.Sc, PGDAL",
    profession: "Assistant Manager - HR, Elite HR Solutions and Services, Chennai",
    parents: "Mr. K.P. Dharmalingam & Mrs. D. Palaniyammal",
    native: "M. Kalathur",
  },
  bride: {
    name: "VISUTHA (alias) R. HEMAPRIYA",
    education: "MA, D.Co-op",
    profession: "Assistant, Co-Operative Urban Bank (Gov), Lalgudi",
    parents: "Mr. T. Ravikumaran (Depo Manager, Dept. of Agri. Gov) & Mrs. R. Senthamarai",
    native: "Manakkal",
  },
  invocationThirukkural: "அன்பும் அறமும் உடைத்தாயின் இல்வாழ்க்கை\nபண்பும் பயனும் அது.",
  blessingIntro: "WITH THE GRACE OF THE ALMIGHTY & THE BLESSINGS OF OUR BELOVED FAMILIES",
  invitationVerse: [
    "TWO LIVES, TWO HEARTS",
    "JOINED TOGETHER IN",
    "FRIENDSHIP, UNITED",
    "FOREVER IN LOVE. WE",
    "JOYFULLY REQUEST THE",
    "HONOUR OF YOUR",
    "PRESENCE AND PRAYERS",
    "AS WE TAKE OUR VOWS",
    "AND BEGIN OUR NEW",
    "JOURNEY TOGETHER.",
  ],
};

const events = [
  {
    number: "01",
    tag: "SACRED WEDDING CEREMONY",
    title: "THE MUHURTHAM",
    tagline: "Mangalya Dharanam & Sacred Vows",
    date: "Sunday, October 25, 2026",
    time: "Auspicious Time: 4:30 AM to 5:30 AM",
    venueName: "Sri Sivakami Ambiga Samedha Chidambareswarar Temple",
    venueLocation: "Mettupatti",
    mapQuery: "Sri Sivakami Ambiga Samedha Chidambareswarar Temple, Mettupatti",
  },
  {
    number: "02",
    tag: "CELEBRATION & FEAST",
    title: "THE RECEPTION",
    tagline: "Felicitation, Dinner & Warm Wishes",
    date: "Sunday, October 25, 2026",
    time: "10:45 AM Onwards",
    venueName: "Sri Balamurugan Thirumana Mandapam",
    venueLocation: "Balasamudram, Thottiyam",
    mapQuery: "Sri Balamurugan Thirumana Mandapam, Balasamudram, Thottiyam",
  },
];



const contacts = [
  {
    side: "Bride's Side",
    place: "Manakkal",
    phones: ["8056492576", "6374330758"],
  },
  {
    side: "Groom's Side",
    place: "M. Kalathur",
    phones: ["9962893736", "8825781654"],
  },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Maneshkumar & Hemapriya — Wedding Invitation</title>
    <meta name="description" content="Wedding celebration invitation of D. Maneshkumar & Visutha (alias) R. Hemapriya." />
    <meta name="theme-color" content="#FDFBF7" />

    <!-- Google Fonts Preconnect & Optimized Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Jost:wght@300;400;500;600&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ─────────────────────────────────────────────────────────────
         ZERO-JAVASCRIPT CSS SCROLL-DRIVEN ANIMATIONS
         100% Native Compositor Thread Hardware-Accelerated (60/120 fps)
         ───────────────────────────────────────────────────────────── */

      :root {
        --color-cream-bg: #FBF8F2;
        --color-terracotta: #DF7A4D;
        --color-gold: #C29B62;
        --color-seal: #B19052;
        --color-text-dark: #2A241E;
        --color-text-muted: #7D6F61;
      }

      /* Parallax Timeline: bound to root page scroll */
      @keyframes templeParallax {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        100% { transform: translate3d(0, 20%, 0) scale(1.03); }
      }

      /* Card Entry Timeline: bound to element view intersection */
      @keyframes cardReveal {
        0% {
          opacity: 0;
          transform: translate3d(0, 44px, 0) scale(0.97);
        }
        100% {
          opacity: 1;
          transform: translate3d(0, 0, 0) scale(1);
        }
      }

      @keyframes textSubtleFade {
        0% { opacity: 0.2; transform: translate3d(0, 16px, 0); }
        100% { opacity: 1; transform: translate3d(0, 0, 0); }
      }

      /* Progressive Enhancement Fallback */
      .scroll-reveal-card {
        opacity: 1;
        transform: none;
        will-change: transform, opacity;
      }

      .parallax-gopuram {
        will-change: transform;
        transform: translate3d(0, 0, 0);
      }

      @supports (animation-timeline: view()) {
        .scroll-reveal-card {
          opacity: 0;
          transform: translate3d(0, 44px, 0) scale(0.97);
          animation: cardReveal cubic-bezier(0.16, 1, 0.3, 1) both;
          animation-timeline: view();
          animation-range: entry 6% cover 26%;
        }

        .scroll-reveal-header {
          animation: textSubtleFade linear both;
          animation-timeline: view();
          animation-range: entry 5% cover 30%;
        }

        .parallax-gopuram {
          animation: templeParallax linear both;
          animation-timeline: scroll(root);
        }
      }

      /* Gold Seal Styling */
      .seal-shimmer {
        background: radial-gradient(circle at 35% 35%, #e6d3a3 0%, #b19052 60%, #85672c 100%);
        box-shadow: 0 2px 8px rgba(177, 144, 82, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.4);
      }
    </style>
  </head>

  <body class="bg-[#FDFBF7] text-[#2A241E] font-['Jost',sans-serif] antialiased overflow-x-hidden selection:bg-[#DF7A4D]/20 selection:text-[#2A241E]">
    
    <!-- ═════════════════════════════════════════════════════════════
         TOP BAR / HEADER (Z-30)
         Matches Venkat.jpg: Monogram left, Antique Gold Seal right
         ═════════════════════════════════════════════════════════════ -->
    <header class="fixed top-0 left-0 right-0 w-full z-30 px-6 py-4 flex justify-between items-center bg-[#FDFBF7]/90 backdrop-blur-md border-b border-[#EFE8DC]/60 transition-all">
      <span class="font-['Cinzel',serif] text-sm sm:text-base font-semibold tracking-[0.28em] text-[#2A241E]">
        {couple.initials}
      </span>
      <div 
        class="w-8 h-8 rounded-full seal-shimmer flex items-center justify-center cursor-pointer transition-transform hover:scale-110 active:scale-95 shadow-[0_2px_8px_rgba(177,144,82,0.4)] border border-[#F5E2B8]/70 p-1" 
        title="Mangala Kalasam — Auspicious Hindu Wedding Symbol"
        aria-label="Auspicious Hindu Wedding Kalasam"
      >
        <svg class="w-5 h-5 text-[#FFF9EE] drop-shadow-[0_1px_1px_rgba(0,0,0,0.35)]" viewBox="0 0 24 24" fill="currentColor">
          <!-- Coconut (Theengai) with tip -->
          <path d="M12 2 C10.8 4 9.8 6.2 9.8 8.2 C10.8 8.9 13.2 8.9 14.2 8.2 C14.2 6.2 13.2 4 12 2 Z" />
          <!-- Five Mango Leaves (Maavilai) fanning outward -->
          <path d="M12 8.2 C10.5 5.8 7 5.2 5 6.8 C6.5 9 9.5 9.2 10.5 9.2 Z" />
          <path d="M12 8.2 C13.5 5.8 17 5.2 19 6.8 C17.5 9 14.5 9.2 13.5 9.2 Z" />
          <path d="M12 8.2 C11 5 8.5 2.8 7.8 3.3 C8.5 5.8 10 7.8 11 8.8 Z" opacity="0.9" />
          <path d="M12 8.2 C13 5 15.5 2.8 16.2 3.3 C15.5 5.8 14 7.8 13 8.8 Z" opacity="0.9" />
          <!-- Pot Rim & Neck (Vaai) -->
          <rect x="8.5" y="9.5" width="7" height="1.6" rx="0.8" />
          <!-- Pot Body (Kumbham) -->
          <path d="M9.5 11.2 C6.8 13.2 6.5 17.2 9 19.8 C10.2 21 13.8 21 15 19.8 C17.5 17.2 17.2 13.2 14.5 11.2 Z" />
          <!-- Pedestal Stand -->
          <path d="M10 21 H14 L15 22.5 H9 Z" />
          <!-- Central Kumkum Tilak -->
          <circle cx="12" cy="15.8" r="1.1" fill="#B19052" stroke="#FFF9EE" stroke-width="0.5" />
        </svg>
      </div>
    </header>

    <main class="w-full max-w-md mx-auto relative">

      <!-- ═══════════════════════════════════════════════════════════
           HERO SECTION (min-h-[100dvh])
           Contains Z-0 (Parallax Temple) & Z-10 (Typography)
           ═══════════════════════════════════════════════════════════ -->
      <section class="relative w-full min-h-[100dvh] pt-20 pb-8 flex flex-col justify-between overflow-hidden">
        
        <!-- STATIC TYPOGRAPHY LAYER (Z-20) -->
        <div class="relative z-20 px-6 flex flex-col items-end text-right w-full">
          
          <!-- Traditional Tamil Hindu Invocation -->
          <div class="mb-1.5 text-right">
            <span class="text-[11px] sm:text-xs text-[#C29B62] font-serif tracking-widest font-medium">
              ॥ ஸ்ரீ விநாயகர் துணை ॥
            </span>
          </div>

          <!-- Sacred Invocation / Blessings -->
          <div class="mb-3 max-w-[340px] text-right">
            <p class="font-['Jost',sans-serif] text-[9px] uppercase tracking-[0.22em] text-[#7D6F61] leading-relaxed">
              {couple.blessingIntro}
            </p>
          </div>

          <!-- Parents Invitation Note -->
          <div class="max-w-[320px] text-right mb-3">
            <p class="text-[9px] uppercase tracking-[0.14em] text-[#9A8A7A] leading-relaxed">
              With blessings of <strong class="text-[#5C4F43]">{couple.groom.parents}</strong> ({couple.groom.native})<br />
              &amp; <strong class="text-[#5C4F43]">{couple.bride.parents}</strong> ({couple.bride.native})
            </p>
          </div>

          <!-- Couple Names: Terracotta & Script Ampersand -->
          <div class="my-1 w-full text-right">
            
            <!-- Groom -->
            <div>
              <h1 class="font-['Cormorant_Garamond',serif] text-2xl min-[380px]:text-[28px] sm:text-3xl md:text-4xl font-normal tracking-normal text-[#DF7A4D] leading-tight whitespace-nowrap">
                {couple.groom.name}
              </h1>
              <p class="text-[9.5px] uppercase tracking-[0.18em] text-[#C29B62] font-medium mt-1">
                {couple.groom.education}
              </p>
              <p class="text-[8.5px] text-[#7D6F61] tracking-wider mt-0.5 max-w-[280px] ml-auto leading-tight">
                {couple.groom.profession}
              </p>
            </div>

            <!-- Ampersand -->
            <div class="text-right pr-6 my-1">
              <span class="font-['Pinyon_Script',cursive] italic text-4xl sm:text-5xl text-[#C29B62] inline-block select-none">
                &amp;
              </span>
            </div>

            <!-- Bride -->
            <div>
              <h1 class="font-['Cormorant_Garamond',serif] text-3xl sm:text-4xl font-normal tracking-wide text-[#DF7A4D] leading-[0.95]">
                {couple.bride.name}
              </h1>
              <p class="text-[9.5px] uppercase tracking-[0.18em] text-[#C29B62] font-medium mt-1">
                {couple.bride.education}
              </p>
              <p class="text-[8.5px] text-[#7D6F61] tracking-wider mt-0.5 max-w-[280px] ml-auto leading-tight">
                {couple.bride.profession}
              </p>
            </div>

          </div>

        </div>

        <!-- ASYMMETRICAL MID-HERO: Temple Left (Z-0) + Poetic Column Right (Z-10) -->
        <div class="relative w-full flex items-end justify-between px-6 pt-4 pb-0 z-10">
          
          <!-- Z-0: Parallax Temple Motif (Anchored to Left/Bottom) -->
          <div class="parallax-gopuram absolute bottom-0 -left-4 w-[60%] sm:w-[54%] max-w-[250px] h-[52vh] max-h-[430px] z-0 pointer-events-none origin-bottom-left">
            <div class="relative w-full h-full">
              <img
                src="/gopuram_seamless.png"
                onerror="this.onerror=null; this.src='/temple_clean.png';"
                alt="Chidambareswarar Temple Tower"
                class="w-full h-full object-contain object-bottom drop-shadow-[0_8px_20px_rgba(223,122,77,0.12)] filter saturate-[1.08] contrast-[1.02]"
                loading="eager"
              />
            </div>
          </div>

          <!-- Z-10: Narrow Columnar Poetic Invitation Verse (Anchored Beside Spire) -->
          <div class="relative z-10 ml-auto text-right w-[44%] max-w-[175px] pb-10">
            <div class="border-r border-[#DF7A4D]/40 pr-3 py-1">
              <p class="font-['Jost',sans-serif] text-[9.5px] font-normal uppercase tracking-[0.2em] leading-[2.1] text-[#42382F] text-right">
                {couple.invitationVerse.map((line) => (
                  <span>{line}<br/></span>
                ))}
              </p>
            </div>

            <!-- Thirukkural Citation Badge -->
            <div class="mt-4 pr-3">
              <p class="text-[11px] sm:text-xs text-[#C29B62] leading-relaxed font-normal">
                "அன்பும் அறமும் உடைத்தாயின் இல்வாழ்க்கை<br />
                பண்பும் பயனும் அது."
              </p>
              <p class="text-[8.5px] tracking-widest text-[#96887B] mt-1.5 font-medium">
                — திருக்குறள் (குறள் 45)
              </p>
            </div>
          </div>

        </div>



      </section>

      <!-- ═══════════════════════════════════════════════════════════
           EVENT SCHEDULE SECTION (Z-20)
           Strictly Wedding & Reception (Haldi & Sangeet Removed)
           ═══════════════════════════════════════════════════════════ -->
      <section class="relative z-20 bg-[#F5F1E8] px-5 py-14 rounded-t-[36px] shadow-[0_-12px_40px_rgba(42,36,30,0.04)] border-t border-[#EFE8DC]">
        
        <!-- Section Header -->
        <div class="text-center mb-10 scroll-reveal-header">
          <h2 class="font-['Cormorant_Garamond',serif] text-3xl sm:text-4xl font-semibold tracking-[0.08em] text-[#2A241E] uppercase">
            Auspicious Events
          </h2>
          <p class="font-['Jost',sans-serif] text-[9.5px] tracking-[0.35em] text-[#7D6F61] uppercase mt-2 font-medium">
            Join In The Holy Matrimony
          </p>
          <div class="w-10 h-[1.5px] bg-[#C29B62] mx-auto mt-3"></div>
        </div>

        <!-- Event Cards Stack -->
        <div class="space-y-7">
          {events.map((event) => (
            <article class="scroll-reveal-card bg-white rounded-[28px] p-7 shadow-[0_8px_30px_rgba(42,36,30,0.04)] border border-[#EFE8DC] text-center flex flex-col items-center">
              
              <span class="text-[9px] uppercase tracking-[0.25em] text-[#DF7A4D] font-semibold mb-1">
                {event.tag}
              </span>

              <h3 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-3xl font-semibold text-[#2A241E] tracking-wide uppercase leading-tight mb-2">
                {event.title}
              </h3>
              
              <p class="text-[10px] tracking-[0.2em] text-[#7D6F61] uppercase font-light mb-3">
                {event.tagline}
              </p>

              <div class="w-12 h-[1px] bg-[#C29B62]/60 mb-3"></div>

              <!-- Date & Time -->
              <p class="font-['Jost',sans-serif] text-xs font-semibold text-[#DF7A4D] tracking-wider mb-1">
                {event.date}
              </p>
              <p class="font-['Jost',sans-serif] text-[11px] font-medium text-[#B8873A] tracking-wider mb-3">
                {event.time}
              </p>

              <!-- Venue Details -->
              <p class="font-['Cormorant_Garamond',serif] text-base text-[#42382F] font-semibold mt-1">
                {event.venueName}
              </p>
              <p class="text-xs text-[#8A7C6D] tracking-wide leading-relaxed font-normal">
                {event.venueLocation}
              </p>

              <!-- Direction Action Button -->
              <div class="mt-5 w-full flex justify-center">
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.mapQuery)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.2em] font-medium text-[#DF7A4D] hover:text-[#C86237] py-2 px-5 rounded-full border border-[#DF7A4D]/30 hover:border-[#DF7A4D] transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Get Directions
                </a>
              </div>

            </article>
          ))}



          <!-- ═════════════════════════════════════════════════════════
               CONTACT & INVITATION DESK CARD
               ═════════════════════════════════════════════════════════ -->
          <article class="scroll-reveal-card bg-white rounded-[28px] p-7 shadow-[0_8px_30px_rgba(42,36,30,0.04)] border border-[#EFE8DC] text-center flex flex-col items-center">
            
            <span class="text-[9px] uppercase tracking-[0.25em] text-[#DF7A4D] font-semibold mb-1">
              CONTACT &amp; ENQUIRIES
            </span>

            <h3 class="font-['Cormorant_Garamond',serif] text-2xl font-semibold text-[#2A241E] tracking-wide uppercase mb-1">
              Cordially Welcoming You
            </h3>
            <p class="text-[10px] tracking-[0.2em] text-[#7D6F61] uppercase font-light mb-4">
              Feel Free to Reach Out
            </p>
            
            <div class="w-12 h-[1px] bg-[#C29B62]/60 mb-5"></div>

            <div class="w-full space-y-4">
              {contacts.map((contact) => (
                <div class="bg-[#F5EFE6] p-4 rounded-2xl border border-[#ECE4D8] text-center">
                  <span class="text-[9px] uppercase tracking-[0.22em] text-[#8A7968] font-bold block mb-1">
                    {contact.side} ({contact.place})
                  </span>
                  
                  <div class="flex flex-wrap justify-center items-center gap-3 mt-2">
                    {contact.phones.map((phone) => (
                      <a
                        href={`tel:${phone}`}
                        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2A241E] hover:text-[#DF7A4D] bg-white py-2 px-3.5 rounded-full border border-[#DFD5C4] shadow-sm transition-all hover:scale-105 active:scale-95"
                      >
                        <svg class="w-3 h-3 text-[#DF7A4D]" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.72 11.72 0 003.68.59 1 1 0 011 1v3.5a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.72 11.72 0 00.59 3.68 1 1 0 01-.24 1.02l-2.23 2.09z" />
                        </svg>
                        {phone}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>

          </article>

        </div>

        <!-- ═════════════════════════════════════════════════════════
             FOOTER: CLOSING GREETING
             "WE CAN'T WAIT TO CELEBRATE WITH YOU!"
             ═════════════════════════════════════════════════════════ -->
        <footer class="mt-20 text-center pb-12 pt-4">
          <div class="w-12 h-[1px] bg-[#C29B62] mx-auto mb-6"></div>
          
          <h2 class="font-['Cormorant_Garamond',serif] text-2xl sm:text-3xl italic tracking-wide text-[#2A241E] leading-snug">
            We can't wait to<br />celebrate with you!
          </h2>
          
          <div class="mt-6 flex justify-center items-center gap-3">
            <span class="w-8 h-[0.5px] bg-[#C29B62]/60"></span>
            <div class="w-2 h-2 rounded-full border border-[#DF7A4D] bg-[#DF7A4D]/20"></div>
            <span class="w-8 h-[0.5px] bg-[#C29B62]/60"></span>
          </div>

          <p class="font-['Cinzel',serif] text-[10px] tracking-[0.25em] text-[#8A7C6D] uppercase mt-5">
            D. Maneshkumar &amp; R. Hemapriya • 2026
          </p>
        </footer>

      </section>

    </main>

  </body>
</html>
